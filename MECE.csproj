    <Reference Include="PrimaMateria">
      <HintPath>TestEnvironment\modded\Mods\raw_dll\PrimaMateria.dll</HintPath>
    </Reference>
    <Reference Include="Sennmetals">
      <HintPath>TestEnvironment\modded\Mods\raw_dll\Sennmetals.dll</HintPath>
    </Reference>
    <Reference Include="UncommonPrimes">
