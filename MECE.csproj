<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <AssemblyName>MECE</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<PropertyGroup>
		<!-- Path to Opus Magnum folder, Contains Lightning.exe et.al -->
		<OpusDir>E:\OMModded\MECE\modded</OpusDir>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

  <ItemGroup>
    <Reference Include="ComplicatedElementsCE">
      <HintPath>TestEnvironment\modded\Mods\raw_dll\ComplicatedElementsCE.dll</HintPath>
    </Reference>
    <Reference Include="DevLightning">
      <HintPath>$(OpusDir)\DevLightning.dll</HintPath>
      <Private>false</Private>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="Extransmutations2">
      <HintPath>TestEnvironment\modded\Mods\raw_dll\Extransmutations2.dll</HintPath>
    </Reference>
    <Reference Include="Fanolytics">
      <HintPath>TestEnvironment\modded\Mods\raw_dll\Fanolytics.dll</HintPath>
    </Reference>
    <Reference Include="Lithos">
      <HintPath>TestEnvironment\modded\Mods\raw_dll\Lithos.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(OpusDir)\Mono.Cecil.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="MonoMod">
      <HintPath>$(OpusDir)\MonoMod.Patcher.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(OpusDir)\MonoMod.Utils.dll</HintPath>
